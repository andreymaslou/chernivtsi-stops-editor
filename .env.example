# Переменные окружения эмулятора (chernivtsi-stops-editor).
#
# Как использовать:
#   cp .env.example .env      # и вписать ключ
# Файл читают и docker compose (env_file в docker-compose.yml), и локальный
# запуск `python main.py` (в main.py есть load_dotenv()). Сам .env в git не
# попадает — см. .gitignore.

# Ключ LLM для разбора фразы («з Калинки до Універу» -> остановки).
# Без него сервер стартует, но /api/route отвечает 502.
# Список моделей через запятую. Сервер пробует их по порядку.
# Основная модель — gpt-4o-mini: стабильно отдаёт валидный JSON по украински
# и суржику. qwen/qwen3.8-flash из цепочки убран — он стабильно возвращал
# не-JSON и тратил ~2 с на каждом запросе. Бесплатные модели остались как резерв.
# Если не сработала ни одна модель, backend перейдёт к локальному
# аварийному разбору фразы и всё равно ответит по-украински.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini,google/gemma-4-26b-a4b-it:free,qwen/qwen3.8-27b:free
# --- Озвучка (TTS) -----------------------------------------------------------
# Движки пробуются по порядку TTS_PROVIDER_ORDER (по умолчанию
# elevenlabs,azure,openai); первый, кто ответит, отдаёт звук. Локального Silero
# в проекте больше нет: его украинские голоса звучали неудовлетворительно, а
# тембр `random` менялся при каждом синтезе одной и той же фразы.
# Если ни один ключ не задан (или все движки упали) — /api/tts вернёт 503, и
# клиент откатится на системний голос браузера (Web Speech).
#
# Ключи читаются в момент синтеза (после load_dotenv), поэтому их можно править
# без пересборки образа. Но сам контейнер нужно ПЕРЕСОЗДАТЬ (`docker compose up -d`),
# иначе env_file в него не подхватится — в уже запущенном процессе переменных нет.
#
# ELEVENLABS_API_KEY — основной движок (model=eleven_multilingual_v2, mp3).
#   Ключу нужно разрешение Text to Speech в кабинете ElevenLabs, иначе 401
#   «missing permission text_to_speech». Голос выбирается в UI (`?speaker=`):
#   профили daniel/adam/george/alice/sarah заданы в VOICE_PROFILES (tts_layer.py).
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL — модель синтеза (по умолчанию eleven_multilingual_v2).
ELEVENLABS_MODEL=
# TTS_DEFAULT_VOICE — профиль, если ?speaker= пуст или неизвестен.
TTS_DEFAULT_VOICE=daniel
# TTS_PROVIDER_ORDER — порядок движков через запятую.
TTS_PROVIDER_ORDER=elevenlabs,azure,openai
#
# AZURE_SPEECH_KEY + AZURE_SPEECH_REGION — резервный движок Azure Speech
#   (голоса uk-UA-OstapNeural / uk-UA-PolinaNeural, у Azure есть бесплатный тариф).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# OPENAI_TTS_KEY — последний резерв (model=tts-1, голоса onyx/nova).
OPENAI_TTS_KEY=
#
# Кэш озвучки: <data>/tts_cache/<engine>/<sha1>.{mp3,json}. Повторные фразы
# (сводки плана) отдаются с диска и не тратят платные символы ElevenLabs.
#   TTS_CACHE=0 — выключить кэш; TTS_HTTP_TIMEOUT_SEC — таймаут запроса к облаку.
TTS_CACHE=1
TTS_HTTP_TIMEOUT_SEC=20

# Тестовый режим (в проде оставить пустыми):
#   ASSUME_IN_SERVICE=1 — все маршруты считаем работающими независимо от
#                         времени суток (ночные запросы ведут себя как дневные);
#   GPS_SIMULATOR=1     — УСТАРЕЛ: работает как PARK_SOURCE=sim.
#                         Оставлен для обратной совместимости.
ASSUME_IN_SERVICE=
GPS_SIMULATOR=

# Источник парка машин (приоритет реального GPS, бриф §3, «Идея A»):
#   auto — опросить оба источника и слить: маршрут (тип ТС + подпись), на
#          котором есть хоть одна реальная машина вне депо с треком не старше
#          ROUTE_FALLBACK_MAX_AGE_SECONDS (час — обед водителя, §3.6), целиком
#          берётся из трекера; остальные маршруты — из симулятора, чтобы
#          демо не было пустым. Каждой машине добавляется поле source:
#          "real" | "sim"; «мёртвые» (старше часа) маршруты в UI помечаются
#          хрестиком ❌;
#   gps  — только реальный трекер;
#   sim  — только виртуальный парк (детерминированные тесты и ночной стенд:
#          без него pytest и эталонные планы станут зависеть от трекера).
# Значение по умолчанию — auto; неизвестное значение трактуется как auto.
PARK_SOURCE=auto

# Папка данных: сленговые правки (slang_overrides.json), логи жалоб и кэш
# озвучки (data/tts_cache/<engine>/<sha1>.*).
# По умолчанию — ./data, в Docker монтируется томом ./data:/app/data.
TRANSGPS_DATA_DIR=
