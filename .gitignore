node_modules/
error_route_1.png
route_34.html
scrape_routes.js
debug_html.js
download_globals.js

# Voice assistant API (main.py)
.env
__pycache__/
*.pyc

# Данные эмулятора: сленговые правки и логи жалоб живут на сервере,
# в репозиторий не попадают (в Docker монтируются томом ./data:/app/data).
data/
!data/.gitkeep

# Логи локального запуска uvicorn (пишутся при запуске сервера на машине)
_server_*.log
*.log

# Временные скрипты и артефакты локальной отладки: скриншоты эмулятора,
# отчёты, одноразовые проверки API. Это не код проекта — в git не нужны.
_*.png
_*.txt
_*.js
_*.py
# ...кроме конвертера stops.json: это рабочий инструмент пайплайна данных,
# он генерирует stops.json для всего проекта (см. его docstring).
!_convert_stops.py

# Артефакт старого прототипа роутера (router_prototype.js пишет его при запуске)
router_demo_out.txt

# Кэши тестов и редакторов
.pytest_cache/
.cursor/

# Результаты замеров (tools/perf) — генерируются, в git не нужны
tools/perf/out/

# Скриншоты и отчёты UI-проверок (tools/ui) — тоже генерируются
tools/ui/out/

